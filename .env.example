# Required in production
DATABASE_URL=postgresql://...
ADMIN_KEY=replace-with-a-long-random-secret
APP_BASE_URL=https://your-domain.example

# Optional / external reputation providers
GOOGLE_WEB_RISK_API_KEY=
PHISHTANK_APP_KEY=
URLHAUS_AUTH_KEY=
ABUSECH_AUTH_KEY=

# Password reset email
RESEND_API_KEY=
RESEND_FROM=SafeDeal <noreply@your-verified-domain.example>

# Keep false on a public release
SHOW_DEMO_DATA=false
